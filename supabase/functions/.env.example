# Set in Supabase Edge Function secrets. Never expose these through VITE_*.
AI_API_KEY=your-provider-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL_ANALYZE=gemini-2.5-flash
AI_MODEL_GENERATE=gemini-2.5-flash-lite
AI_MODEL_TRANSLATE=gemini-2.5-flash-lite
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.

# Alternatively, use an OpenAI key without AI_API_KEY/AI_BASE_URL/AI_MODEL_*:
# OPENAI_API_KEY=your-openai-api-key
# Default: https://api.openai.com/v1, model gpt-5.4-mini-2026-03-17.
# For local Windows hosting, only OPENAI_API_KEY in .env.local in this folder
# is read by the launcher, and only the backend function container receives it.
