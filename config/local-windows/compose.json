{
  "services": {
    "db": {
      "restart": "unless-stopped",
      "labels": {
        "pokemon.scope": "local-windows"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "cpus": 1.0,
      "image": "postgres:17-alpine",
      "mem_limit": "512m",
      "environment": {
        "POSTGRES_HOST": "/var/run/postgresql",
        "PGPORT": "5432",
        "POSTGRES_PORT": "5432",
        "PGPASSWORD": "${POKEMON_DB_PASSWORD:?}",
        "POSTGRES_PASSWORD": "${POKEMON_DB_PASSWORD:?}",
        "PGDATABASE": "postgres",
        "POSTGRES_DB": "postgres"
      },
      "volumes": [
        "pokemon-db:/var/lib/postgresql/data",
        "./roles.sql:/docker-entrypoint-initdb.d/10-pokemon.sql:ro"
      ],
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -U postgres -h 127.0.0.1"],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      },
      "command": [
        "postgres",
        "-c",
        "shared_buffers=128MB",
        "-c",
        "log_min_messages=warning"
      ]
    },
    "mail": {
      "restart": "unless-stopped",
      "labels": {
        "pokemon.scope": "local-windows"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "cpus": 1.0,
      "image": "axllent/mailpit@sha256:0790692be935ea4420d085694f7985b1f692ca6a8771ab0e0bd8ba75ac180498",
      "mem_limit": "128m",
      "read_only": true,
      "cap_drop": ["ALL"],
      "tmpfs": ["/tmp:size=67108864,mode=1777"],
      "ports": ["127.0.0.1:5225:8025"],
      "environment": {
        "MP_DATABASE": "/tmp/mailpit.db",
        "MP_MAX_MESSAGES": "100"
      }
    },
    "auth": {
      "restart": "unless-stopped",
      "labels": {
        "pokemon.scope": "local-windows"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "cpus": 1.0,
      "image": "supabase/gotrue:v2.197.0",
      "mem_limit": "192m",
      "read_only": true,
      "cap_drop": ["ALL"],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        },
        "mail": {
          "condition": "service_started"
        }
      },
      "environment": {
        "GOTRUE_API_HOST": "0.0.0.0",
        "GOTRUE_API_PORT": "9999",
        "API_EXTERNAL_URL": "http://127.0.0.1:5220/backend/auth/v1",
        "GOTRUE_DB_DRIVER": "postgres",
        "GOTRUE_DB_DATABASE_URL": "postgres://supabase_auth_admin:${POKEMON_DB_PASSWORD:?}@db:5432/postgres",
        "GOTRUE_SITE_URL": "http://127.0.0.1:5220",
        "GOTRUE_URI_ALLOW_LIST": "http://127.0.0.1:5220/",
        "GOTRUE_DISABLE_SIGNUP": "false",
        "GOTRUE_EXTERNAL_EMAIL_ENABLED": "true",
        "GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED": "false",
        "GOTRUE_MAILER_AUTOCONFIRM": "false",
        "GOTRUE_JWT_ADMIN_ROLES": "service_role",
        "GOTRUE_JWT_AUD": "authenticated",
        "GOTRUE_JWT_DEFAULT_GROUP_NAME": "authenticated",
        "GOTRUE_JWT_EXP": "3600",
        "GOTRUE_JWT_SECRET": "${POKEMON_JWT_SECRET:?}",
        "GOTRUE_SMTP_ADMIN_EMAIL": "noreply@pokemon.local",
        "GOTRUE_SMTP_HOST": "mail",
        "GOTRUE_SMTP_PORT": "1025",
        "GOTRUE_SMTP_USER": "",
        "GOTRUE_SMTP_PASS": "",
        "GOTRUE_SMTP_SENDER_NAME": "Pokemon Card Lens lokalt",
        "GOTRUE_MAILER_URLPATHS_INVITE": "/backend/auth/v1/verify",
        "GOTRUE_MAILER_URLPATHS_CONFIRMATION": "/backend/auth/v1/verify",
        "GOTRUE_MAILER_URLPATHS_RECOVERY": "/backend/auth/v1/verify",
        "GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE": "/backend/auth/v1/verify",
        "GOTRUE_DB_NAMESPACE": "auth"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://127.0.0.1:9999/health"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      }
    },
    "rest": {
      "restart": "unless-stopped",
      "labels": {
        "pokemon.scope": "local-windows"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "cpus": 1.0,
      "image": "postgrest/postgrest:v14.18",
      "mem_limit": "192m",
      "read_only": true,
      "cap_drop": ["ALL"],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "PGRST_DB_URI": "postgres://authenticator:${POKEMON_DB_PASSWORD:?}@db:5432/postgres",
        "PGRST_DB_SCHEMAS": "public",
        "PGRST_DB_ANON_ROLE": "anon",
        "PGRST_JWT_SECRET": "${POKEMON_JWT_SECRET:?}",
        "PGRST_DB_MAX_ROWS": "1000",
        "PGRST_ADMIN_SERVER_PORT": "3001"
      }
    },
    "functions": {
      "restart": "unless-stopped",
      "labels": {
        "pokemon.scope": "local-windows"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "cpus": 1.0,
      "image": "pokemon-local-functions:20261025",
      "mem_limit": "256m",
      "build": {
        "context": "../..",
        "dockerfile": "config/local-windows/Dockerfile",
        "target": "functions",
        "args": {
          "LOCAL_PUBLIC_URL": "http://127.0.0.1:5220/backend",
          "LOCAL_ANON_KEY": "${POKEMON_ANON_KEY:?}"
        }
      },
      "read_only": true,
      "cap_drop": ["ALL"],
      "tmpfs": ["/tmp:size=268435456,mode=1777"],
      "environment": {
        "SUPABASE_URL": "http://web:8080/backend",
        "SUPABASE_ANON_KEY": "${POKEMON_ANON_KEY:?}",
        "SUPABASE_SERVICE_ROLE_KEY": "${POKEMON_SERVICE_KEY:?}",
        "OPENAI_API_KEY": "${POKEMON_OPENAI_API_KEY:-}"
      },
      "depends_on": {
        "auth": {
          "condition": "service_healthy"
        },
        "rest": {
          "condition": "service_started"
        }
      }
    },
    "web": {
      "restart": "unless-stopped",
      "labels": {
        "pokemon.scope": "local-windows"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      },
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 128,
      "cpus": 1.0,
      "image": "pokemon-local-web:20261025",
      "mem_limit": "128m",
      "build": {
        "context": "../..",
        "dockerfile": "config/local-windows/Dockerfile",
        "target": "web",
        "args": {
          "LOCAL_PUBLIC_URL": "http://127.0.0.1:5220/backend",
          "LOCAL_ANON_KEY": "${POKEMON_ANON_KEY:?}"
        }
      },
      "read_only": true,
      "cap_drop": ["ALL"],
      "tmpfs": ["/tmp:size=67108864,mode=1777"],
      "ports": ["127.0.0.1:5220:8080"],
      "depends_on": {
        "auth": {
          "condition": "service_healthy"
        },
        "rest": {
          "condition": "service_started"
        },
        "functions": {
          "condition": "service_started"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://127.0.0.1:8080/healthz"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      }
    }
  },
  "volumes": {
    "pokemon-db": {}
  }
}
